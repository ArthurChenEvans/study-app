{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Study App",
  "version": "0.1.0",
  "identifier": "com.arthurchenevans.studyapp",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "Study App", "width": 1280, "height": 840, "minWidth": 960, "minHeight": 640 }],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'; worker-src 'self' blob:; object-src 'none'; form-action 'none'; base-uri 'none'"
    }
  },
  "bundle": { "active": true, "targets": ["deb", "appimage"], "icon": ["icons/icon.png"] }
}
