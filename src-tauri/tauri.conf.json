{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Shudhana",
  "version": "0.1.0",
  "identifier": "com.arthurchenevans.studyapp",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Shudhana",
        "width": 1280,
        "height": 840,
        "minWidth": 360,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'; worker-src 'self' blob:; object-src 'none'; form-action 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm",
      "appimage",
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "category": "Education",
    "shortDescription": "Spaced quizzes, flashcards and free recall in one place",
    "longDescription": "Shudhana schedules multiple choice and short answer quizzes, flashcards and free recall checks, and tightens them before your exams. Everything stays on your computers.",
    "linux": {
      "rpm": {
        "release": "1",
        "obsoletes": [
          "study-app"
        ]
      },
      "deb": {}
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "createUpdaterArtifacts": true,
    "fileAssociations": [
      {
        "ext": [
          "studyapp"
        ],
        "name": "Shudhana file",
        "description": "Shudhana study data",
        "mimeType": "application/x-shudhana",
        "role": "Editor"
      }
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQxNjhEMzMzNzRCQjJEQ0UKUldUT0xidDBNOU5vUVJVa1FYQTBYaFY0U0NFMkdRWW1TMGExVzJhRXRPSU1kSHVhNm5YTHRBeWEK",
      "endpoints": [
        "https://github.com/ArthurChenEvans/study-app/releases/latest/download/latest.json"
      ]
    }
  }
}
